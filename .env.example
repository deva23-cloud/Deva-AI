# Copy this file to .env in your cloud development environment.
# Never commit .env or paste API keys into browser JavaScript.
PORT=3000
APP_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-a-long-random-secret
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=replace-with-a-model-supported-by-your-provider
AI_API_KEY=replace-with-your-provider-key
